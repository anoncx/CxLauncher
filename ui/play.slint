import { Theme } from "theme.slint";
import { Card, Dots, Edge, Icon, Icons, MenuAction, MenuDivider, MenuPick, Pixel, Popover, Roll, Spinner } from "components.slint";
import { ProfileItem } from "types.slint";

component Field inherits Rectangle {
    in property <image> tile;

    clip: true;

    Image {
        width: root.width;
        height: root.height;
        source: root.tile;
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        colorize: Theme.dot-off;
    }

    Rectangle {
        y: root.height * 0.55;
        height: root.height * 0.45;
        background: @linear-gradient(180deg, Theme.paper.transparentize(1) 0%, Theme.paper 100%);
    }
}

component PlayButton inherits Rectangle {
    in property <int> state;
    in property <float> progress;
    in property <string> time;
    in property <bool> ready;
    callback clicked();

    property <bool> working: state >= 1 && state <= 3;
    property <bool> running: state == 4;
    property <bool> pulse;

    width: 236px;
    height: 58px;
    border-radius: Theme.pill(self.height);
    background: working || running ? Theme.surface : Theme.ink;
    opacity: ready || working || running ? 1 : 0.45;
    transform-scale: touch.pressed ? 0.96 : touch.has-hover && !working ? 1.025 : 1;
    drop-shadow-blur: Theme.effects && !working && !running ? 24px : 0;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: !Theme.effects || working || running ? transparent : Theme.dark ? Theme.accent.transparentize(0.75) : #00000030;
    clip: true;
    accessible-role: button;
    accessible-label: running ? "Playing" : working ? "Preparing" : "Play";
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.smooth; }
    animate transform-scale { duration: Theme.bounce; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    Timer {
        interval: 900ms;
        running: root.running && !Theme.calm;
        triggered => { root.pulse = !root.pulse; }
    }

    Rectangle {
        x: 0;
        width: root.working ? root.width * max(0.04, root.progress) : 0;
        background: Theme.accent.transparentize(0.78);
        animate width { duration: Theme.calm ? 0ms : 300ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }

    if !root.working && !root.running: HorizontalLayout {
        alignment: center;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                commands: Icons.play;
                tint: Theme.paper;
                solid: true;
            }
        }

        Text {
            text: "Play";
            font-size: 18px;
            font-weight: 600;
            color: Theme.paper;
            vertical-alignment: center;
        }
    }

    if root.working: HorizontalLayout {
        alignment: center;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Spinner { size: 18px; }
        }

        Text {
            text: root.state == 1 ? "Checking" : root.state == 2 ? "Downloading" : "Starting";
            font-size: 16px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
    }

    if root.running: HorizontalLayout {
        alignment: center;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: Theme.round(5px);
                background: Theme.accent;
                transform-scale: root.pulse ? 1.25 : 0.85;
                opacity: root.pulse ? 1 : 0.65;
                animate transform-scale, opacity { duration: 850ms; easing: ease-in-out; }
            }
        }

        Text {
            text: "Playing";
            font-size: 16px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }

        Text {
            text: root.time;
            font-family: Theme.mono;
            font-size: 13px;
            color: Theme.grey;
            vertical-alignment: center;
        }
    }

    Edge { inset: Theme.pill(root.height); }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> menu;
    callback clicked();

    height: 30px;
    border-radius: Theme.round(15px);
    background: touch.has-hover ? Theme.surface : Theme.surface.transparentize(Theme.dark ? 0.3 : 0.15);
    border-width: 1px;
    border-color: Theme.hair;
    transform-scale: touch.pressed ? 0.95 : 1;
    animate background { duration: Theme.quick; }
    animate transform-scale { duration: Theme.bounce; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: root.menu ? 10px : 12px;
        spacing: 7px;

        VerticalLayout {
            alignment: center;
            Icon {
                width: root.icon != "" ? 13px : 0;
                height: 13px;
                visible: root.icon != "";
                commands: root.icon;
                tint: Theme.accent;
            }
        }

        Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: 500;
            color: Theme.ink;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Icon {
                width: root.menu ? 11px : 0;
                height: 11px;
                visible: root.menu;
                commands: Icons.down;
            }
        }
    }
}

component Stat inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;

    Text {
        text: root.label;
        font-size: 11px;
        color: Theme.grey;
    }

    Text {
        text: root.value;
        font-family: Theme.dots;
        font-weight: 900;
        font-size: 22px;
        color: Theme.ink;
        overflow: elide;
    }
}

export component PlayPage inherits Rectangle {
    in property <image> tile;
    in property <string> client-name: "CxVisuals";
    in property <string> client-version;
    in property <string> game-version;
    in property <string> loader-label;
    in property <string> loader-name;
    in property <int> mod-count;
    in property <bool> client-on: true;
    in property <int> state;
    in property <float> progress;
    in property <string> detail;
    in property <string> error;
    in property <string> time;
    in property <bool> has-account;
    in property <image> figure;
    in property <string> account-name;
    in property <[string]> notes;
    in property <int> online: -1;
    in property <string> played;
    in property <string> last-played;
    in property <string> profile-name;
    in property <int> profile-glyph;
    in property <[ProfileItem]> profiles;
    in property <string> profile-id;
    callback command(string);

    property <bool> working: state >= 1 && state <= 3;
    property <string> title: root.client-on ? root.client-name : root.profile-name;
    property <float> reveal: 0;
    init => { self.reveal = 1; }

    hero := Rectangle {
        y: 0;
        height: root.height - cards.height - 12px;

        Field {
            tile: root.tile;
        }

        if Theme.effects: Rectangle {
            x: parent.width * 0.72 - self.width / 2;
            y: parent.height * 0.5 - self.height / 2;
            width: 520px;
            height: 520px;
            background: @radial-gradient(circle, Theme.accent.transparentize(Theme.dark ? 0.8 : 0.88) 0%, Theme.accent.transparentize(1) 62%);
        }

        figure := Rectangle {
            property <length> tall: min(parent.height - 60px, 300px);
            x: parent.width * 0.72 - self.width / 2;
            y: (parent.height - self.height) / 2 + 8px;
            width: tall / 2;
            height: tall;

            Rectangle {
                y: parent.height - 10px;
                x: -parent.width * 0.15;
                width: parent.width * 1.3;
                height: 22px;
                background: @radial-gradient(circle, Theme.ink.transparentize(Theme.dark ? 0.7 : 0.82) 0%, Theme.ink.transparentize(1) 70%);
            }

            Pixel {
                width: parent.width;
                height: parent.height;
                source: root.figure;
                opacity: root.has-account ? 1 : 0.55;
            }
        }

        content := VerticalLayout {
            x: 44px;
            y: (parent.height - self.preferred-height) / 2;
            width: min(parent.width * 0.6, 560px);
            height: self.preferred-height;
            spacing: 0;

            HorizontalLayout {
                alignment: start;
                padding-bottom: 6px;

                profile-chip := Chip {
                    text: root.profile-name;
                    icon: Icons.glyphs[root.profile-glyph];
                    menu: true;
                    clicked => { profile-menu.show(); }
                }
            }

            Rectangle {
                height: 92px;
                clip: true;

                Rectangle {
                    x: 0;
                    width: parent.width * root.reveal;
                    clip: true;
                    animate width { duration: Theme.calm ? 0ms : 1100ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }

                    Text {
                        x: 0;
                        width: root.width;
                        text: root.title;
                        font-family: Theme.dots;
                        font-weight: 900;
                        font-size: Math.max(36px, Math.min(78px, 640px / Math.max(9, root.title.character-count)));
                        color: Theme.ink;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                padding-bottom: 26px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: Theme.round(3.5px);
                        background: root.state == 4 ? Theme.accent : Theme.grey.transparentize(0.4);
                        animate background { duration: 300ms; }
                    }
                }

                Text {
                    text: (root.client-on && root.client-version != "" ? root.client-version + "  ·  " : "") + "Minecraft " + root.game-version + "  ·  " + root.loader-label;
                    font-family: Theme.mono;
                    font-size: 12px;
                    color: Theme.grey;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                alignment: start;
                spacing: 10px;

                PlayButton {
                    state: root.state;
                    progress: root.progress;
                    time: root.time;
                    ready: root.has-account;
                    clicked => { root.command(root.working ? "cancel" : root.state == 4 ? "console" : "play"); }
                }

                if root.working || root.state == 4: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Theme.round(20px);
                        background: stop.has-hover ? Theme.surface-2 : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.hair;
                        transform-scale: stop.pressed ? 0.9 : 1;
                        animate background { duration: Theme.quick; }
                        animate transform-scale { duration: Theme.bounce; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

                        stop := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.command(root.working ? "cancel" : "stop"); }
                        }

                        Icon {
                            width: 14px;
                            height: 14px;
                            commands: root.working ? Icons.close : Icons.stop;
                            tint: stop.has-hover ? Theme.alert : Theme.ink-2;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                padding-top: 18px;
                height: 40px;

                if root.working: VerticalLayout {
                    alignment: center;
                    Dots {
                        progress: root.progress;
                        busy: root.state != 2;
                        count: 28;
                    }
                }

                if root.working && root.state == 2: VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 1px;
                        Roll {
                            value: Math.round(root.progress * 100);
                            digits: 3;
                            size: 12px;
                        }
                        Text {
                            text: "%";
                            font-family: Theme.mono;
                            font-size: 12px;
                            color: Theme.ink;
                            vertical-alignment: center;
                        }
                    }
                }

                Text {
                    text: root.error != "" && !root.working ? root.error : !root.has-account && !root.working ? "Sign in with Microsoft to play" : root.detail;
                    font-size: 12px;
                    color: root.error != "" && !root.working ? Theme.alert : Theme.grey;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        profile-menu := PopupWindow {
            x: content.x;
            y: content.y + 36px;
            width: 260px;

            Popover {
                for p in root.profiles: MenuPick {
                    title: p.name;
                    detail: p.detail;
                    active: p.active;
                    clicked => { root.command("profile:" + p.id); }

                    Icon {
                        commands: Icons.glyphs[p.glyph];
                        tint: p.active ? Theme.accent : Theme.ink-2;
                    }
                }

                MenuDivider { }

                MenuAction {
                    icon: Icons.edit;
                    title: "Edit profile…";
                    clicked => { root.command("edit-profile"); }
                }

                MenuAction {
                    icon: Icons.plus;
                    title: "New profile";
                    clicked => { root.command("new-profile"); }
                }

                MenuAction {
                    icon: Icons.folder;
                    title: "Open game folder";
                    clicked => { root.command("open-game-folder"); }
                }
            }
        }
    }

    cards := HorizontalLayout {
        y: root.height - self.height;
        height: 148px;
        spacing: 12px;

        Card {
            horizontal-stretch: 1.3;
            preferred-width: 100px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "What's new";
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.client-on ? root.client-version : "";
                        font-family: Theme.mono;
                        font-size: 11px;
                        color: Theme.grey;
                    }
                }

                if root.notes.length == 0: Text {
                    text: root.client-on ? "Release notes for " + root.client-name + " show up here." : "This profile runs without CxVisuals. Turn it on in the profile to get its modules.";
                    font-size: 12px;
                    color: Theme.grey;
                    wrap: word-wrap;
                }

                for note[i] in root.notes: HorizontalLayout {
                    spacing: 8px;
                    visible: i < 3;
                    height: i < 3 ? self.preferred-height : 0;

                    VerticalLayout {
                        padding-top: 6px;
                        alignment: start;
                        Rectangle {
                            width: 4px;
                            height: 4px;
                            border-radius: Theme.round(2px);
                            background: i == 0 ? Theme.accent : Theme.grey;
                        }
                    }

                    Text {
                        text: note;
                        font-size: 12px;
                        color: Theme.ink-2;
                        wrap: word-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        Card {
            horizontal-stretch: 1.2;
            preferred-width: 100px;

            if !root.client-on: VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    Text {
                        text: "This profile";
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Edit";
                        font-size: 12px;
                        color: edit.has-hover ? Theme.ink : Theme.accent;
                        edit := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.command("edit-profile"); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 18px;
                    Stat {
                        label: "Minecraft";
                        value: root.game-version;
                    }
                    Stat {
                        label: "Loader";
                        value: root.loader-name;
                    }
                    Stat {
                        label: "Mods";
                        value: root.mod-count;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }

            if root.client-on: VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    Text {
                        text: "In game";
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: key.preferred-width + 12px;
                        height: 20px;
                        border-radius: Theme.round(6px);
                        background: Theme.surface-2;
                        key := Text {
                            text: "Right Shift";
                            font-family: Theme.mono;
                            font-size: 10.5px;
                            color: Theme.ink-2;
                        }
                    }
                }

                property <[string]> modules: ["Idle Camera", "Hands", "Motion Blur", "Animations", "Spatial UI", "HUD"];

                for row in 2: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    for m[i] in [modules[row * 3], modules[row * 3 + 1], modules[row * 3 + 2]]: Rectangle {
                        height: 26px;
                        width: label.preferred-width + 18px;
                        border-radius: Theme.round(13px);
                        background: chip.has-hover ? Theme.surface-2.darker(Theme.dark ? -0.2 : 0.05) : Theme.surface-2;
                        transform-scale: chip.has-hover ? 1.04 : 1;
                        animate background { duration: Theme.quick; }
                        animate transform-scale { duration: Theme.bounce; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }

                        chip := TouchArea { }

                        label := Text {
                            text: m;
                            font-size: 11.5px;
                            font-weight: 500;
                            color: Theme.ink-2;
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        Card {
            horizontal-stretch: 1;
            preferred-width: 100px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Session";
                        font-weight: 600;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }

                    if root.online >= 0: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: Theme.round(3px);
                                background: Theme.accent;
                            }
                        }
                        Roll {
                            value: root.online;
                            digits: 5;
                            size: 11px;
                            tint: Theme.ink-2;
                        }
                        Text {
                            text: "online";
                            font-size: 11px;
                            color: Theme.grey;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 18px;
                    Stat {
                        label: "Played";
                        value: root.played;
                    }
                    Stat {
                        label: "Last";
                        value: root.last-played;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
