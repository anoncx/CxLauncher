import { Theme } from "theme.slint";
import { Command } from "types.slint";

export global Icons {
    out property <string> play: "M8 5.5v13l10.5-6.5z";
    out property <string> mods: "M4 8l8-4 8 4-8 4zM4 8v8l8 4 8-4V8M12 12v8";
    out property <string> profiles: "M12 4l8 4-8 4-8-4zM4 12l8 4 8-4M4 16l8 4 8-4";
    out property <string> console: "M4 5h16v14H4zM8 10l3 2-3 2M13 15h3";
    out property <string> settings: "M4 7h9M17 7h3M4 17h3M11 17h9M15 5v4M9 15v4";
    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> folder: "M4 7h6l2 2h8v10H4z";
    out property <string> check: "M5 12l5 5 9-10";
    out property <string> close: "M6 6l12 12M18 6L6 18";
    out property <string> down: "M6 9l6 6 6-6";
    out property <string> right: "M9 6l6 6-6 6";
    out property <string> search: "M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0 -13M15.5 15.5L20 20";
    out property <string> trash: "M5 7h14M10 7V5h4v2M7 7l1 13h8l1-13";
    out property <string> copy: "M8 8h11v11h-11zM5 15h-1v-11h11v1";
    out property <string> stop: "M7 7h10v10H7z";
    out property <string> external: "M14 4h6v6M20 4l-9 9M18 14v6H4V6h6";
    out property <string> bolt: "M13 3L5 14h6l-1 7 8-11h-6z";
    out property <string> user: "M12 12a4 4 0 1 0 0-8a4 4 0 1 0 0 8M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6";
    out property <string> download: "M12 4v11M7 10l5 5 5-5M5 20h14";
    out property <string> repair: "M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6";
    out property <string> signout: "M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10";
    out property <string> server: "M4 5h16v6H4zM4 13h16v6H4zM8 8h.5M8 16h.5";
    out property <string> edit: "M4 20h4L19 9l-4-4L4 16zM14 6l4 4";
    out property <string> warn: "M12 4l9 16H3zM12 10v4M12 17v.5";
    out property <string> lock: "M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3";
    out property <[string]> glyphs: [
