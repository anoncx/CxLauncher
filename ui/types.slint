    offline: bool,
}

export struct ProfileItem {
    id: string,
    name: string,
    glyph: int,
    detail: string,
    stats: string,
    pack: string,
    active: bool,
}

export struct ModItem {
    file: string,
    name: string,
    version: string,
    detail: string,
    icon: image,
    has-icon: bool,
    letter: string,
    enabled: bool,
    managed: bool,
}

export struct FindItem {
