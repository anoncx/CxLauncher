}

export struct ModImage {
    image: image,
    has-image: bool,
    failed: bool,
    title: string,
}

export struct BodyBlock {
    is-image: bool,
    text: styled-text,
    alt: string,
    link: string,
    image: image,
    state: int,
}

export struct VersionItem {
    id: string,
    title: string,
    detail: string,
    tag: string,
}

export struct VersionPick {
    id: string,
    title: string,
}

